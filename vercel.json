{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/analyze.mjs": {
      "maxDuration": 300
    },
    "api/transcribe.mjs": {
      "maxDuration": 300
    },
    "api/transcribe-block.mjs": {
      "maxDuration": 300
    },
    "api/extract-block-evidence.mjs": {
      "maxDuration": 120
    },
    "api/presidio.py": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
        {"key": "Service-Worker-Allowed", "value": "/"}
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=3600"},
        {"key": "Content-Type", "value": "application/manifest+json; charset=utf-8"}
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"},
        {"key": "Pragma", "value": "no-cache"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"}
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "Permissions-Policy", "value": "microphone=(self), screen-wake-lock=(self), camera=(), geolocation=()"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"}
      ]
    }
  ]
}
